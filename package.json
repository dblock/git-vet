{
  "name": "svet",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "plugins/files/*",
    "plugins/checks/*"
  ],
  "description": "Git and filesystem linter.",
  "type": "module",
  "exports": {
    ".": "./src/index.mjs",
    "./defaults": "./defaults.mjs"
  },
  "bin": {
    "svet": "./bin/svet.mjs",
    "git-svet": "./bin/svet.mjs"
  },
  "files": [
    "bin",
    "defaults.mjs",
    "src",
    "docs",
    "plugins/files/git/README.md",
    "plugins/files/glob/README.md",
    "plugins/checks/git-index-lf/README.md",
    "plugins/checks/file-lf/README.md",
    "artwork",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "DESIGN.md",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "Daniel Doubrovkine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dblock/svet.git"
  },
  "bugs": {
    "url": "https://github.com/dblock/svet/issues"
  },
  "homepage": "https://github.com/dblock/svet#readme",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "artwork": "node scripts/render-artwork.mjs",
    "lint": "eslint . && prettier --check .",
    "check": "node bin/svet.mjs",
    "format": "prettier --write .",
    "test": "node --test"
  },
  "dependencies": {
    "@svet/check-file-lf": "0.1.0",
    "@svet/files-git": "0.1.0",
    "@svet/files-glob": "0.1.0",
    "import-meta-resolve": "4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "16.5.0",
    "prettier": "3.9.10"
  }
}
