{
  "name": "git-vet",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "plugins/*",
    "plugins/files/*"
  ],
  "description": "Git and filesystem linter.",
  "type": "module",
  "exports": "./src/index.mjs",
  "files": [
    "src",
    "docs",
    "plugins/files/git/README.md",
    "plugins/files/glob/README.md",
    "artwork",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "Daniel Doubrovkine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dblock/git-vet.git"
  },
  "bugs": {
    "url": "https://github.com/dblock/git-vet/issues"
  },
  "homepage": "https://github.com/dblock/git-vet#readme",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "artwork": "node scripts/render-artwork.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "node --test"
  },
  "dependencies": {
    "@git-vet/files-glob": "0.1.0",
    "import-meta-resolve": "4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "16.5.0",
    "prettier": "3.9.10"
  }
}
